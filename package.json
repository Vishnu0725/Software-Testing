{
  "name": "movie-seat-booking-playwright-project",
  "version": "1.0.0",
  "private": true,
  "description": "Software testing mini-project: automated testing of movie ticket booking seat selection flow",
  "scripts": {
    "start": "http-server app -p 4173 -c-1",
    "test": "playwright test",
